# ==============================================================================
# PRALEYE (प्रलय-दृष्टि): Zero-Config Production Environment Template
# Autonomous Multi-Hazard Disaster Intelligence & Tactical Command Platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173

# Database (Default: Embedded SQLite WAL Mode, upgradeable to PostgreSQL+PostGIS)
DATABASE_URL=sqlite+aiosqlite:///./data/praleye.db
# DATABASE_URL=postgresql+asyncpg://praleye:praleye_secret@localhost:5432/praleye_db

# In-Memory / Disk Caching
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=300

# Local AI / Ollama Settings (Optional, deterministic fallback active when offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Public Keyless Telemetry APIs (100% Free)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
NASA_FIRMS_URL=https://eonet.gsfc.nasa.gov/api/v3/events
PHOTON_GEOCODE_URL=https://photon.komoot.io/api/
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

